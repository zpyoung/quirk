{
  "name": "quirk-companion-shell",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open /shell.html",
    "typecheck": "tsc --noEmit",
    "tokens": "python3 scripts/gen_tokens.py > src/quirk-tokens.css",
    "tokens-check": "tsx scripts/check-tokens.ts",
    "steps-check": "tsx scripts/check-steps.ts",
    "template-check": "tsx scripts/check-template.ts",
    "check": "pnpm run typecheck && pnpm run tokens-check && pnpm run steps-check && pnpm run template-check",
    "build": "vite build"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.2",
    "@astryxdesign/theme-neutral": "0.6.2",
    "markdown-it": "15.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.20.5",
    "typescript": "6.0.2",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  }
}
