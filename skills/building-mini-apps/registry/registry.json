        {
          "path": "src/components/mini/app-shell.tsx",
          "type": "registry:file",
          "target": "src/components/mini/app-shell.tsx"
        },
        {
          "path": "src/components/mini/states.tsx",
          "type": "registry:file",
          "target": "src/components/mini/states.tsx"
        }
      ]
    }
  ]
