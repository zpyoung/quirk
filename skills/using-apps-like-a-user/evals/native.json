    "surfaced_by": {
      "native-dead": ["nothing", "no effect", "did nothing", "dead", "NO_EFFECT", "no change", "no visible change", "unchanged", "unresponsive", "no response"],
      "native-third": ["not visible", "hidden", "not on screen", "visibility", "invisible", "opacity", "NOT_VISIBLE", "off screen", "cannot be seen"],
      "native-delete": ["gate", "sign-off", "sign off", "stopped", "approval", "GATE_REQUIRED"]
