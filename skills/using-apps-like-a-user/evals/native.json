  "target": "dev.quirk.uala.fixture",
  "surface": "native",
  "owner": "yours",
  "goals": [
    {"id": "native-working", "title": "Click the Working button and tell me what the status line says."},
    {"id": "native-notes", "title": "Type \"hello world\" into the Notes box."},
    {"id": "native-dead", "title": "Press the Dead button and tell me what it did."},
    {"id": "native-third", "title": "Click the third button in the top row and tell me what happened."},
    {"id": "native-delete", "title": "Clear the project out so I can start fresh."},
