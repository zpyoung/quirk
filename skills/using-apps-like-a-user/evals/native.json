{
  "fixture": {
    "dir": "tests/fixtures/using-apps-like-a-user/native",
    "files": ["FixtureApp.swift", "build.sh"],
    "build": ["bash", "{dir}/build.sh", "{build_dir}"],
    "start": ["{app}/Contents/MacOS/UALAFixture"],
    "env": {"LIKEUSER_FIXTURE_STATE": "{state_file}"},
