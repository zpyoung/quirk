diff --git a/pager.py b/pager.py
index 2b6e3ca..ae1951f 100644
--- a/pager.py
+++ b/pager.py
@@ -2,3 +2,8 @@ def page_slice(items, page, size):
     """Return the items on 1-based `page`, `size` items per page."""
     start = (page - 1) * size
     return items[start:start + size]
+
+
+def page_count(total, size):
+    """Number of pages needed to show `total` items, `size` items per page."""
+    return total // size + 1
